# Credenciales del Lab. Copia este archivo a .env y rellena los valores.
# IMPORTANTE: son de la cuenta lab de Cloudflare, NUNCA las de producción.

# Account ID de la cuenta lab (Cloudflare → Workers & Pages → panel derecho)
CLOUDFLARE_ACCOUNT_ID=

# Token con permiso "Cloudflare Pages: Edit" sobre la cuenta lab, y nada más
CLOUDFLARE_API_TOKEN=
